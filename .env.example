# -----------------------------------------------------------------------------
# Aurum Finances — variáveis de ambiente
# Copie este arquivo para `.env` e preencha com valores locais.
# NUNCA versione o `.env` nem coloque credenciais reais aqui.
# -----------------------------------------------------------------------------

# URL pública da aplicação
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Banco de dados (MySQL) — usado a partir da Fase 4
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/aurum_finances"

# Auth.js — usado a partir da Fase 5
# Gere um segredo com: npx auth secret   (ou: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
